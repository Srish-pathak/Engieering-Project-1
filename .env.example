# ==============================================================================
# TechSpecAnalyser — Environment Configuration Template
# Copy this file to .env and configure your values. Never commit .env to Git!
# ==============================================================================

# Google Gemini AI API Configuration
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model (e.g. gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# GitHub Integration Configuration
# Optional: Required for private repositories and raises rate limit to 5,000 req/hr
# Generate at: https://github.com/settings/tokens (Scope: repo or public_repo)
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub Webhook Secret (HMAC-SHA256 signature verification)
# Must match the Secret configured in your GitHub Repo -> Settings -> Webhooks
WEBHOOK_SECRET=your_secure_webhook_secret_key_here

# Database Configuration
# Defaults to techspec.db in the root directory
TECHSPEC_DB_PATH=techspec.db

# Repository Analysis Safeguards & Limits
MAX_REPO_FILES=30
MAX_FILE_BYTES=204800
